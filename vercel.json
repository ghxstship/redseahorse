{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/solutions",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/solutions/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/experiential-production",
      "destination": "/services/experiential-design-production/",
      "permanent": true
    },
    {
      "source": "/services/experiential-production/",
      "destination": "/services/experiential-design-production/",
      "permanent": true
    },
    {
      "source": "/services/site-operations",
      "destination": "/services/venue-site-operations/",
      "permanent": true
    },
    {
      "source": "/services/site-operations/",
      "destination": "/services/venue-site-operations/",
      "permanent": true
    },
    {
      "source": "/services/venue-management",
      "destination": "/services/venue-site-operations/",
      "permanent": true
    },
    {
      "source": "/services/venue-management/",
      "destination": "/services/venue-site-operations/",
      "permanent": true
    },
    {
      "source": "/services/immersive-technologies",
      "destination": "/services/technology-systems-engineering/",
      "permanent": true
    },
    {
      "source": "/services/immersive-technologies/",
      "destination": "/services/technology-systems-engineering/",
      "permanent": true
    },
    {
      "source": "/services/technology-systems-implementation",
      "destination": "/services/technology-systems-engineering/",
      "permanent": true
    },
    {
      "source": "/services/technology-systems-implementation/",
      "destination": "/services/technology-systems-engineering/",
      "permanent": true
    },
    {
      "source": "/resources/the-experiential-gc",
      "destination": "/resources/the-experiential-producer/",
      "permanent": true
    },
    {
      "source": "/resources/the-experiential-gc/",
      "destination": "/resources/the-experiential-producer/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/theme.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/site-form.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
