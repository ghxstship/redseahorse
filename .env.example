# GHXSTSHIP contact form (Resend). Copy to Vercel → Project → Settings →
# Environment Variables. Do NOT commit real values.

# Required: your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: verified sender. Defaults to Resend's shared onboarding@resend.dev,
# which can only deliver to your own Resend account email (so the submitter
# auto-reply is skipped entirely on the default sender).
#
# Production is set to:  GHXSTSHIP <ghxstship@atlvs.pro>
# That is atlvs.pro on purpose, not ghxstship.tours: an inquiry becomes a project
# tracked in ATLVS, so the sender matches the system that owns the record.
# atlvs.pro is the verified domain in Resend; ghxstship.tours is NOT verified
# there, setting a .tours sender would make Resend reject every send.
#
# Format must be bare "email@example.com" or "Name <email@example.com>". Do NOT
# wrap the value in quotes when entering it in the Vercel dashboard, it stores
# the value literally, and a stray quote or newline 422s every send.
# RESEND_FROM=GHXSTSHIP <ghxstship@atlvs.pro>

# Optional: where inquiries are delivered. Defaults to julian.clarkson@ghxstship.pro
# CONTACT_TO=julian.clarkson@ghxstship.pro
